# Copy to .env for local Docker/compose runs. Do not commit .env.

# Required for `docker compose run --rm review`.
GH_REPO=owner/repo
PR_NUMBER=123
# Minimum fine-grained token permissions for normal local reviews:
# Contents read, Pull requests read, Issues read/write, Checks read/write.
# Add Pull requests read/write for inline suggestions; add Contents
# read/write as well for draft-fix PR dispatch.
GH_TOKEN=
# Optional: app installation token for local runs that should report as
# the cora GitHub App instead of the GH_TOKEN actor. In GitHub Actions,
# set CORA_APP_ID and CORA_APP_PRIVATE_KEY secrets instead; the workflow
# mints this value for you.
CORA_GH_TOKEN=
LLM_GATEWAY_KEY=

# OpenAI-compatible endpoint/model. Point these at your own gateway.
LITELLM_BASE_URL=http://localhost:4000
REVIEW_MODEL=review

# Use quick mode locally by default: no MCP/tool loop.
MAX_TOOL_ITERATIONS=0

# Optional local retrieval over files in the mounted checkout.
# Example: docs/**/*.md,README.md,*.md
AGENT_REVIEW_RETRIEVAL_GLOB=

# Patch-writing is opt-in. Leave false for comment/check-run-only review.
REVIEW_PROPOSE_PATCH_DISPATCH=false

# Safer trigger defaults for public/adopter testing.
REVIEW_TRIGGER_ENFORCE=true
REVIEW_TRIGGER_UNTRUSTED_ACTION=skip
REVIEW_TRIGGER_FORK_ACTION=comment-only
